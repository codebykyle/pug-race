# Settings for `docker compose`. Copy to .env and edit:
#
#   cp .env.example .env
#
# .env is git-ignored because it holds the host password.

# Host password for running races. Leave empty to have one generated: it is
# printed in `docker compose logs` and saved in the data volume.
PUG_HOST_PASSWORD=

# Port on the host that serves the game (the container always uses 8731).
PUG_PORT=8731

# Address on the host to listen on. 0.0.0.0 serves every interface; use
# 127.0.0.1 when a reverse proxy on the same machine is the only way in.
PUG_BIND=0.0.0.0

# Image tag to run: latest, a release such as 1.2.3, or sha-<commit>.
PUG_IMAGE_TAG=latest
